root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Constants take precedence over static and instance field rules.
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_fields_camel_case.severity = warning
dotnet_naming_rule.static_fields_camel_case.symbols = static_fields
dotnet_naming_rule.static_fields_camel_case.style = static_camel_case
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_rule.instance_fields_camel_case.severity = warning
dotnet_naming_rule.instance_fields_camel_case.symbols = instance_fields
dotnet_naming_rule.instance_fields_camel_case.style = prefixed_camel_case
dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = private, internal

dotnet_naming_rule.interfaces_pascal_case.severity = warning
dotnet_naming_rule.interfaces_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_pascal_case.style = interface_pascal_case
dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_rule.type_parameters_pascal_case.severity = warning
dotnet_naming_rule.type_parameters_pascal_case.symbols = type_parameters
dotnet_naming_rule.type_parameters_pascal_case.style = type_parameter_pascal_case
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_rule.types_and_members_pascal_case.severity = warning
dotnet_naming_rule.types_and_members_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case
dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, property, event

dotnet_naming_rule.visible_fields_pascal_case.severity = warning
dotnet_naming_rule.visible_fields_pascal_case.symbols = visible_fields
dotnet_naming_rule.visible_fields_pascal_case.style = pascal_case
dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, protected, protected_internal

dotnet_naming_rule.parameters_and_locals_camel_case.severity = warning
dotnet_naming_rule.parameters_and_locals_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_camel_case.style = camel_case
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.prefixed_camel_case.required_prefix = _
dotnet_naming_style.prefixed_camel_case.capitalization = camel_case
dotnet_naming_style.static_camel_case.required_prefix = s_
dotnet_naming_style.static_camel_case.capitalization = camel_case
dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case
dotnet_naming_style.type_parameter_pascal_case.required_prefix = T
dotnet_naming_style.type_parameter_pascal_case.capitalization = pascal_case

[test/**/*.cs]
csharp_style_namespace_declarations = file_scoped:warning

[examples/Benchmark/**/*.cs]
csharp_style_namespace_declarations = file_scoped:warning

[*.Designer.cs]
generated_code = true
